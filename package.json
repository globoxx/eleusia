    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "chart.js": "^4.3.0",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "image-size": "^1.0.2",
    "mui-image": "^1.0.7",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-countdown-circle-timer": "^3.2.1",
