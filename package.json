{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@tensorflow/tfjs": "^4.6.0",
    "chart.js": "^4.3.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "react": "^19.2.6",
    "react-chartjs-2": "^5.2.0",
    "react-countdown-circle-timer": "^3.2.1",
    "react-dom": "^19.2.6",
    "socket.io": "^4.6.1",
    "socket.io-client": "^4.6.1"
  },
  "scripts": {
    "start": "node dist/server/server.js",
    "start:client": "vite",
    "start:server": "ts-node --project tsconfig.server.json server.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && vite build && node ./node_modules/typescript/bin/tsc -p tsconfig.server.json",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit && node ./node_modules/typescript/bin/tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  }
}
