    "ts-node": "^10.9.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "node dist/server/server.js",
    "start:client": "vite",
    "start:server": "ts-node --project tsconfig.server.json server.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && vite build && node ./node_modules/typescript/bin/tsc -p tsconfig.server.json",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit && node ./node_modules/typescript/bin/tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.21",
    "@types/mui-image": "^1.0.1",
    "jsdom": "^27.0.0",
    "vite": "^7.1.10",
    "vitest": "^3.2.4"
  }
